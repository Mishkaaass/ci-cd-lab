FROM python:3.14-slim

# Keep Blue/Green demo on the same fixed Debian zstd revision as OpsBoard.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade libzstd1 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libzstd1)" ge 1.5.7+dfsg-1+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements-demo.txt .

RUN python -m pip install \
    --no-cache-dir \
    -r requirements-demo.txt

COPY demo_service ./demo_service

EXPOSE 8000

USER 10001:10001

CMD ["uvicorn", "demo_service.main:app", "--host", "0.0.0.0", "--port", "8000"]
